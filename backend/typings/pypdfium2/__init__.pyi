"""Type stubs for ``pypdfium2`` covering the PDF text/render surface used here."""

from __future__ import annotations

from collections.abc import Iterator
from typing import Any

class PdfiumError(Exception): ...

class _RawConstants:
    """pdfium C 常量集合（仅声明本仓库用到的页面对象类型）。"""

    FPDF_PAGEOBJ_UNKNOWN: int
    FPDF_PAGEOBJ_TEXT: int
    FPDF_PAGEOBJ_PATH: int
    FPDF_PAGEOBJ_IMAGE: int
    FPDF_PAGEOBJ_SHADING: int
    FPDF_PAGEOBJ_FORM: int

raw: _RawConstants

class PdfTextPage:
    def get_text_bounded(self, left: float = ..., bottom: float = ..., right: float = ..., top: float = ...) -> str | None: ...
    def close(self) -> None: ...

class PdfBitmap:
    def to_pil(self) -> Any: ...
    def close(self) -> None: ...

class PdfObject:
    @property
    def type(self) -> int: ...
    def get_bounds(self) -> tuple[float, float, float, float]: ...

class PdfPage:
    def get_textpage(self) -> PdfTextPage: ...
    def get_size(self) -> tuple[float, float]: ...
    def get_objects(self) -> Iterator[PdfObject]: ...
    def render(self, scale: float = ..., **kwargs: Any) -> PdfBitmap: ...

class PdfDocument:
    def __init__(self, input: bytes | str | Any, password: str | None = ...) -> None: ...
    def __len__(self) -> int: ...
    def __getitem__(self, index: int) -> PdfPage: ...
    def close(self) -> None: ...
