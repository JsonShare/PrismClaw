# ── Tavily API keys ──────────────────────────────────────────────────
# Comma/newline separated. Round-robin pooled with per-key cooldown
# backoff. Free-tier keys have ~1000 calls/month each; 4 keys = ~4000/mo.
# Get yours at https://tavily.com
WSM_TAVILY_API_KEYS=

# ── AnySearch API key ──────────────────────────────────────────────
# Free tier: 1000 req/day, 20 QPS. Used for both search and page extraction.
# Get yours at https://anysearch.com
WSM_ANYSEARCH_API_KEY=

# ── Budgets ─────────────────────────────────────────────────────────
WSM_TOTAL_TIMEOUT_S=45
WSM_SEARCH_TIMEOUT_S=12
WSM_FETCH_TIMEOUT_S=15

# ── Agent loop ──────────────────────────────────────────────────────
WSM_MAX_AGENT_ROUNDS=2
WSM_LOG_LEVEL=INFO
