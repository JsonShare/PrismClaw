# ── 语料位置（两份都要保留 .git：历史与按日期读取依赖它） ─────────────
# global-law 克隆：manifest.json 在根目录，china/jurisdiction.json 在里面
CLM_GLOBAL_LAW_ROOT=~/.prismclaw/database/global-law

# china-law 克隆：启动时自动链成 global-law/china/national/acts（已有子模块则不动）
# 留空表示不用链接，直接使用 global-law 里 checkout 好的子模块
CLM_ACTS_ROOT=~/.prismclaw/database/china-law

# 服务哪些法域（逗号分隔；留空表示语料树里检出的全部）
CLM_JURISDICTIONS=china
