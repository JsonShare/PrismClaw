# PrismClaw production environment variables.
# Copy to deploy/.env and fill in real values before running docker compose.
#
# Generate strong random values with:
#   python -c "import secrets; print(secrets.token_urlsafe(64))"

# ══════════════════════════════════════════════════════════════════════
# REQUIRED — Application will not start without these
# ══════════════════════════════════════════════════════════════════════

# ── Web channel auth ───────────────────────────────────────────────────
# JWT signing secret for session tokens.
PRISMCLAW_WEB_JWT_SECRET=replace-me-with-64-random-bytes

# Admin token for /api/admin/* endpoints (cluster status, user management).
PRISMCLAW_WEB_ADMIN_TOKEN=replace-me-with-32-random-bytes

# ── PostgreSQL ─────────────────────────────────────────────────────────
# Password for the prismclaw DB user. Used by both the PG container and workers.
POSTGRES_PASSWORD=replace-me-with-strong-password

# ── Redis ──────────────────────────────────────────────────────────────
# Password for Redis (requirepass). Workers use this to authenticate.
REDIS_PASSWORD=replace-me-with-strong-password

# ── First-run admin bootstrap ─────────────────────────────────────────
# These seed the initial admin user on first startup.
# After the first successful seed they are ignored.
PRISMCLAW_WEB_USER_BOOTSTRAP_ADMIN_ID=admin
PRISMCLAW_WEB_USER_BOOTSTRAP_ADMIN_PASSWORD=replace-me-with-strong-password

# ── Runtime-Agent HMAC (single-node full-stack deployment) ───────────
# Shared HMAC-SHA256 secret between main app and Runtime-Agent containers.
# Used by WorkspaceRuntimeClient to sign all bash/MCP requests.
# MUST be set to a strong random value in production.
HMAC_SECRET=replace-me-with-strong-secret

# ── web-search-mcp ────────────────────────────────────────────────────
# Shared bearer token (X-WSM-Token) between the prismclaw app and the
# standalone web-search-mcp container. Required: compose fails fast when unset.
WEB_SEARCH_MCP_TOKEN=replace-me-with-strong-secret
# Search provider. Empty TAVILY_API_KEYS disables search entirely.
# Multiple Tavily keys are comma-separated (round-robin pool with per-key
# cooldown backoff; 429 monthly-limit cooldown caps at 1h to avoid wasting
# calls on exhausted keys).
TAVILY_API_KEYS=
# AnySearch API key (free tier: 1000 req/day, 20 QPS). Used for search + extract.
ANYSEARCH_API_KEY=
# WSM_* service knobs (see mcp_servers/web-search-mcp/src/web_search_mcp/config.py)
WEB_SEARCH_MCP_LOG_LEVEL=INFO

# ══════════════════════════════════════════════════════════════════════
# OPTIONAL — Production tuning
# ══════════════════════════════════════════════════════════════════════

# ── Application ────────────────────────────────────────────────────────
# Log level (DEBUG, INFO, WARNING, ERROR)
PRISMCLAW_LOG_LEVEL=INFO
# Number of uvicorn workers per container
PRISMCLAW_WEB_WORKERS=4

# ── LLM Provider API Keys ─────────────────────────────────────────────
# These map to settings.agent.providers.<name>.apiKey at runtime via the
# PRISMCLAW_AGENT_PROVIDERS_<NAME>_API_KEY env override mechanism (pydantic).
# In practice it is simpler to put keys in backend/configs/models.yaml directly
# (mounted read-only) than to env-override the nested structure.
#
# Example:
# PRISMCLAW_AGENT_PROVIDERS_OPENAI_API_KEY=sk-...
# PRISMCLAW_AGENT_PROVIDERS_ANTHROPIC_API_KEY=sk-ant-...

# ── PostgreSQL backup profile (single-node full-stack) ───────────────
# Used by the `backup` profile in docker-compose.yml (one-shot container).
# When BACKUP_S3_BUCKET is empty, backups land in the pg-backups volume only.
# Backed by scripts/pg_backup.sh: pg_dump -Fc | gzip → local 7-day retention
# → optional `aws s3 cp` upload.
# BACKUP_S3_BUCKET=s3://my-bucket/prismclaw
# AWS_REGION=us-east-1
